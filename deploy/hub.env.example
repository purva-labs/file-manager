# Address owned by the hub on your private network (Tailscale recommended).
PRIVATE_IP=100.64.0.10
HUB_PORT=3090
AGENT_PORT=3091

# Use absolute host paths. Relative paths can resolve differently under Compose.
NODES_FILE=/opt/file-manager/config/nodes.json
SECRETS_DIR=/opt/file-manager/secrets
AGENT_TOKEN_FILE=/opt/file-manager/secrets/server-one.token
